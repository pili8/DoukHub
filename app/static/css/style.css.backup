/* ==========================================================================
   DoukHub Design System
   Design Read: Internal admin panel for content collection platform
   Dials: VARIANCE=4, MOTION=3, DENSITY=5
   Accent: Teal (#0d9488) - not AI-purple, professional
   Icons: Phosphor Icons (via CDN)
   ========================================================================== */

/* ===== 1. Design Tokens ===== */
:root {
  /* Neutral - Slate (cool gray) */
  --bg-base: #f8fafc;
  --bg-surface: #ffffff;
  --bg-sidebar: #0f172a;
  --bg-sidebar-hover: #1e293b;
  --bg-sidebar-active: #1e293b;
  --bg-hover: #f1f5f9;
  --bg-muted: #f8fafc;
  --bg-elevated: #ffffff;
  --bg-input: #ffffff;

  /* Text */
  --text-primary: #0f172a;
  --text-secondary: #475569;
  --text-muted: #94a3b8;
  --text-on-dark: #f1f5f9;
  --text-on-dark-muted: #94a3b8;
  --text-on-dark-dim: #64748b;

  /* Border */
  --border-default: #e2e8f0;
  --border-strong: #cbd5e1;
  --border-sidebar: #1e293b;

  /* Accent - Teal */
  --accent: #0d9488;
  --accent-hover: #0f766e;
  --accent-active: #115e59;
  --accent-light: #f0fdfa;
  --accent-text: #0f766e;

  /* Status */
  --success: #059669;
  --success-light: #ecfdf5;
  --success-text: #047857;
  --danger: #dc2626;
  --danger-light: #fef2f2;
  --danger-text: #b91c1c;
  --warning: #d97706;
  --warning-light: #fffbeb;
  --warning-text: #92400e;
  --info: #2563eb;
  --info-light: #eff6ff;
  --info-text: #1d4ed8;

  /* Radius */
  --radius-sm: 6px;
  --radius: 8px;
  --radius-lg: 12px;
  --radius-full: 9999px;

  /* Shadow */
  --shadow-xs: 0 1px 2px 0 rgb(15 23 42 / 0.04);
  --shadow-sm: 0 1px 3px 0 rgb(15 23 42 / 0.06), 0 1px 2px -1px rgb(15 23 42 / 0.04);
  --shadow-md: 0 4px 6px -1px rgb(15 23 42 / 0.07), 0 2px 4px -2px rgb(15 23 42 / 0.04);
  --shadow-lg: 0 10px 15px -3px rgb(15 23 42 / 0.08), 0 4px 6px -4px rgb(15 23 42 / 0.04);

  /* Transition */
  --transition: 150ms cubic-bezier(0.4, 0, 0.2, 1);
  --transition-slow: 250ms cubic-bezier(0.4, 0, 0.2, 1);

  /* Typography */
  --font-sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", "Noto Sans SC", "Microsoft YaHei", sans-serif;
  --font-mono: "SF Mono", "Cascadia Code", "Fira Code", Consolas, monospace;

  /* Layout */
  --sidebar-w: 220px;
  --sidebar-w-mobile: 160px;
  --content-max: 1280px;
}

/* ===== Dark Mode ===== */
@media (prefers-color-scheme: dark) {
  :root {
    --bg-base: #0f172a;
    --bg-surface: #1e293b;
    --bg-sidebar: #020617;
    --bg-sidebar-hover: #1e293b;
    --bg-sidebar-active: #334155;
    --bg-hover: #334155;
    --bg-muted: #1e293b;
    --bg-elevated: #1e293b;
    --bg-input: #0f172a;

    --text-primary: #f1f5f9;
    --text-secondary: #cbd5e1;
    --text-muted: #64748b;
    --text-on-dark: #f1f5f9;
    --text-on-dark-muted: #94a3b8;
    --text-on-dark-dim: #475569;

    --border-default: #334155;
    --border-strong: #475569;
    --border-sidebar: #1e293b;

    --accent: #2dd4bf;
    --accent-hover: #5eead4;
    --accent-active: #14b8a6;
    --accent-light: #042f2e;
    --accent-text: #5eead4;

    --success: #34d399;
    --success-light: #022c22;
    --success-text: #6ee7b7;
    --danger: #f87171;
    --danger-light: #450a0a;
    --danger-text: #fca5a5;
    --warning: #fbbf24;
    --warning-light: #451a03;
    --warning-text: #fcd34d;
    --info: #60a5fa;
    --info-light: #172554;
    --info-text: #93c5fd;

    --shadow-xs: 0 1px 2px 0 rgb(0 0 0 / 0.2);
    --shadow-sm: 0 1px 3px 0 rgb(0 0 0 / 0.3), 0 1px 2px -1px rgb(0 0 0 / 0.2);
    --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.3), 0 2px 4px -2px rgb(0 0 0 / 0.2);
    --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.3), 0 4px 6px -4px rgb(0 0 0 / 0.2);
  }
}

/* ===== 2. Reset & Base ===== */
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

html { font-size: 15px; -webkit-text-size-adjust: 100%; }

body {
  font-family: var(--font-sans);
  background: var(--bg-base);
  color: var(--text-primary);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

a { color: var(--accent-text); text-decoration: none; transition: color var(--transition); }
a:hover { color: var(--accent-hover); }

code, pre { font-family: var(--font-mono); }

/* ===== 3. Layout ===== */
.layout { display: flex; min-height: 100vh; }

.sidebar {
  width: var(--sidebar-w);
  background: var(--bg-sidebar);
  color: var(--text-on-dark);
  flex-shrink: 0;
  position: sticky;
  top: 0;
  align-self: flex-start;
  height: 100vh;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  border-right: 1px solid var(--border-sidebar);
}

.sidebar-brand {
  padding: 20px 20px 16px;
  border-bottom: 1px solid var(--border-sidebar);
  display: flex;
  align-items: center;
  gap: 10px;
}

.sidebar-brand i {
  font-size: 24px;
  color: var(--accent);
}

.sidebar-brand span {
  font-size: 17px;
  font-weight: 700;
  letter-spacing: -0.01em;
  color: var(--text-on-dark);
}

.sidebar-nav {
  flex: 1;
  padding: 8px 0;
}

.sidebar-nav a {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 20px;
  color: var(--text-on-dark-muted);
  text-decoration: none;
  font-size: 14px;
  font-weight: 500;
  transition: all var(--transition);
  border-left: 3px solid transparent;
}

.sidebar-nav a i {
  font-size: 18px;
  flex-shrink: 0;
}

.sidebar-nav a:hover {
  background: var(--bg-sidebar-hover);
  color: var(--text-on-dark);
}

.sidebar-nav a.active {
  background: var(--bg-sidebar-active);
  color: var(--accent);
  border-left-color: var(--accent);
}

.sidebar-footer {
  padding: 12px 20px;
  border-top: 1px solid var(--border-sidebar);
  font-size: 12px;
  color: var(--text-on-dark-dim);
}

.main {
  flex: 1;
  padding: 28px 32px;
  max-width: var(--content-max);
  min-width: 0;
}

/* ===== 4. Page Header ===== */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28px;
  gap: 16px;
}

.page-header h2 {
  font-size: 22px;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--text-primary);
}

.page-header-actions {
  display: flex;
  gap: 8px;
  align-items: center;
  flex-wrap: wrap;
}

/* ===== 5. Cards ===== */
.card {
  background: var(--bg-surface);
  border: 1px solid var(--border-default);
  border-radius: var(--radius-lg);
  padding: 22px;
  margin-bottom: 16px;
  box-shadow: var(--shadow-xs);
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.card h3 {
  margin-bottom: 14px;
  font-size: 14px;
  font-weight: 600;
  color: var(--text-secondary);
  text-transform: none;
  letter-spacing: 0;
  display: flex;
  align-items: center;
  gap: 8px;
}

.card h3 i {
  font-size: 18px;
  color: var(--accent);
}

/* ===== 6. Buttons ===== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 8px 16px;
  border: 1px solid transparent;
  border-radius: var(--radius-sm);
  cursor: pointer;
  font-size: 14px;
  font-weight: 500;
  font-family: inherit;
  white-space: nowrap;
  transition: all var(--transition);
  text-decoration: none;
  line-height: 1.4;
}

.btn:active {
  transform: scale(0.98);
}

.btn i {
  font-size: 16px;
}

.btn-primary {
  background: var(--accent);
  color: #fff;
  border-color: var(--accent);
}
.btn-primary:hover {
  background: var(--accent-hover);
  border-color: var(--accent-hover);
  color: #fff;
}

.btn-secondary {
  background: var(--bg-surface);
  color: var(--text-secondary);
  border-color: var(--border-default);
}
.btn-secondary:hover {
  background: var(--bg-hover);
  color: var(--text-primary);
  border-color: var(--border-strong);
}

.btn-success {
  background: var(--success);
  color: #fff;
  border-color: var(--success);
}
.btn-success:hover {
  background: #047857;
  color: #fff;
}

.btn-danger {
  background: var(--danger);
  color: #fff;
  border-color: var(--danger);
}
.btn-danger:hover {
  background: #b91c1c;
  color: #fff;
}

.btn-warning {
  background: var(--warning);
  color: #fff;
  border-color: var(--warning);
}
.btn-warning:hover {
  background: #92400e;
  color: #fff;
}

.btn-sm {
  padding: 5px 10px;
  font-size: 12px;
}
.btn-sm i { font-size: 14px; }

.btn:disabled {
  opacity: 0.5;
  pointer-events: none;
}

.btn-group {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

/* ===== 7. Forms ===== */
.form-group {
  margin-bottom: 18px;
}

.form-group label {
  display: block;
  margin-bottom: 6px;
  font-weight: 500;
  font-size: 13px;
  color: var(--text-secondary);
}

.form-group input,
.form-group select,
.form-group textarea {
  width: 100%;
  padding: 9px 12px;
  border: 1px solid var(--border-default);
  border-radius: var(--radius-sm);
  font-size: 14px;
  font-family: inherit;
  background: var(--bg-input);
  color: var(--text-primary);
  transition: border-color var(--transition), box-shadow var(--transition);
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-light);
}

.form-group input::placeholder,
.form-group textarea::placeholder {
  color: var(--text-muted);
}

.form-group textarea {
  min-height: 100px;
  resize: vertical;
}

.form-group small {
  color: var(--text-muted);
  font-size: 12px;
}

/* ===== 8. Tables ===== */
.table-scroll {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

table {
  width: 100%;
  border-collapse: collapse;
}

th, td {
  padding: 10px 14px;
  text-align: left;
  border-bottom: 1px solid var(--border-default);
  white-space: nowrap;
  font-size: 13px;
}

th {
  background: var(--bg-muted);
  font-weight: 600;
  font-size: 12px;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

tbody tr {
  transition: background var(--transition);
}

tbody tr:hover {
  background: var(--bg-hover);
}

/* ===== 9. Stats Grid ===== */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin-bottom: 24px;
}

.stat-card {
  background: var(--bg-surface);
  border: 1px solid var(--border-default);
  border-radius: var(--radius-lg);
  padding: 20px;
  box-shadow: var(--shadow-xs);
}

.stat-card .number {
  font-size: 30px;
  font-weight: 700;
  color: var(--accent);
  letter-spacing: -0.02em;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.stat-card .label {
  font-size: 12px;
  color: var(--text-muted);
  margin-top: 4px;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  font-weight: 500;
}

/* ===== 10. Service Grid ===== */
.service-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
  margin-bottom: 24px;
}

.service-card {
  background: var(--bg-surface);
  border: 1px solid var(--border-default);
  border-radius: var(--radius-lg);
  padding: 20px;
  box-shadow: var(--shadow-xs);
}

.service-card .name {
  font-size: 15px;
  font-weight: 600;
  margin-bottom: 6px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.service-card .port {
  font-size: 12px;
  color: var(--text-muted);
  font-family: var(--font-mono);
}

/* ===== 11. Status Indicators ===== */
.status-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}

.status-running { background: var(--success); box-shadow: 0 0 0 3px var(--success-light); }
.status-stopped { background: var(--danger); box-shadow: 0 0 0 3px var(--danger-light); }

.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 3px 10px;
  border-radius: var(--radius-full);
  font-size: 12px;
  font-weight: 600;
}

.status-badge.running {
  background: var(--success-light);
  color: var(--success-text);
}

.status-badge.stopped {
  background: var(--danger-light);
  color: var(--danger-text);
}

/* ===== 12. Tags & Badges ===== */
.tag {
  display: inline-block;
  padding: 2px 10px;
  border-radius: var(--radius-full);
  font-size: 12px;
  background: var(--bg-hover);
  color: var(--text-secondary);
  margin-right: 4px;
  font-weight: 500;
  border: 1px solid var(--border-default);
}

.rating { color: var(--warning); letter-spacing: 1px; }

.platform-tag {
  display: inline-block;
  padding: 2px 10px;
  border-radius: var(--radius-sm);
  font-size: 12px;
  font-weight: 500;
}

.platform-抖音 { background: var(--warning-light); color: var(--warning-text); }
.platform-TikTok { background: var(--info-light); color: var(--info-text); }
.platform-小红书 { background: var(--danger-light); color: var(--danger-text); }

/* ===== 13. Toast ===== */
.toast {
  position: fixed;
  top: 20px;
  right: 20px;
  padding: 12px 20px;
  border-radius: var(--radius);
  color: #fff;
  z-index: 2000;
  display: none;
  max-width: 90vw;
  font-size: 14px;
  font-weight: 500;
  box-shadow: var(--shadow-lg);
  animation: toast-in 200ms cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes toast-in {
  from { transform: translateY(-12px); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.toast-success { background: var(--success); }
.toast-error { background: var(--danger); }
.toast-info { background: var(--info); }

/* ===== 14. Utilities ===== */
.loading { opacity: 0.5; pointer-events: none; }

.empty-state {
  text-align: center;
  padding: 48px 20px;
  color: var(--text-muted);
}

.empty-state i {
  font-size: 40px;
  color: var(--border-strong);
  margin-bottom: 12px;
  display: block;
}

/* ===== 15. Progress Bar ===== */
.progress-bar-container {
  width: 100%;
  height: 6px;
  background: var(--border-default);
  border-radius: var(--radius-full);
  margin: 8px 0;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: var(--accent);
  border-radius: var(--radius-full);
  transition: width 300ms cubic-bezier(0.4, 0, 0.2, 1);
}

/* ===== 16. Log Box ===== */
.log-box {
  max-height: 200px;
  overflow-y: auto;
  background: #0f172a;
  color: #cbd5e1;
  border-radius: var(--radius);
  padding: 12px 16px;
  font-family: var(--font-mono);
  font-size: 12px;
  line-height: 1.7;
  border: 1px solid #1e293b;
}

.log-box .log-ok { color: #34d399; }
.log-box .log-err { color: #f87171; }
.log-box .log-info { color: #60a5fa; }

/* ===== 17. Responsive ===== */
@media (max-width: 1024px) {
  .stats-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 768px) {
  .sidebar {
    width: var(--sidebar-w-mobile);
    padding: 0;
  }
  .sidebar-brand { padding: 14px 14px 12px; }
  .sidebar-brand span { font-size: 14px; }
  .sidebar-brand i { font-size: 20px; }
  .sidebar-nav a { padding: 10px 14px; font-size: 13px; gap: 8px; }
  .sidebar-nav a i { font-size: 16px; }

  .main { padding: 16px; max-width: 100%; }

  .page-header {
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
    margin-bottom: 18px;
  }
  .page-header h2 { font-size: 19px; }
  .page-header-actions { align-self: stretch; }
  .page-header-actions .btn { text-align: center; flex: 1; }

  .card { padding: 16px; border-radius: var(--radius); margin-bottom: 12px; }
  .card h3 { font-size: 13px; }

  .stats-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; margin-bottom: 16px; }
  .stat-card { padding: 14px; }
  .stat-card .number { font-size: 24px; }
  .stat-card .label { font-size: 11px; }

  .service-grid { grid-template-columns: 1fr; gap: 10px; margin-bottom: 16px; }

  .form-group input, .form-group select, .form-group textarea { font-size: 15px; }

  .btn { padding: 9px 14px; font-size: 14px; }
  .btn-sm { padding: 6px 10px; font-size: 12px; }

  th, td { padding: 8px 10px; font-size: 12px; }

  .toast { top: 10px; left: 10px; right: 10px; max-width: none; }
}

@media (max-width: 420px) {
  .stats-grid { grid-template-columns: 1fr; }
  .main { padding: 12px; }
}

/* ===== 18. Reduced Motion ===== */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
